# Mechon AI - Local Environment Configuration Example
# Copy to .env for custom local overrides

# Host and Port (Default loopback 127.0.0.1)
HOST=127.0.0.1
PORT=18420

# Optional custom storage paths (defaults to XDG directories ~/.local/share/mechon-ai)
# DATA_DIR=/path/to/custom/data
# CONFIG_DIR=/path/to/custom/config

# Inference Endpoints (Local Defaults)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=
