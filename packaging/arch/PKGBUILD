# Maintainer: Mechon AI Team <team@mechon.ai>
pkgname=mechon-ai
pkgver=1.0.0
pkgrel=1
pkgdesc="Native cross-platform desktop workstation for SFT and DPO dataset engineering"
arch=('x86_64')
url="https://github.com/Mechon-AI/mechon-ai"
license=('Apache-2.0')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'sqlite'
    'python>=3.11'
    'openssl'
)
makedepends=(
    'rust'
    'cargo'
    'nodejs>=18'
    'npm'
    'python-setuptools'
)
optdepends=(
    'ollama: local offline inference runtime'
    'python-pyarrow: Parquet dataset acceleration'
    'python-pandas: advanced dataframe analytics'
)
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/Mechon-AI/mechon-ai/archive/v$pkgver.tar.gz"
    "mechon-ai.desktop"
)
sha256sums=('SKIP' 'SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver/frontend"
    npm install
    npm run build

    cd "$srcdir/$pkgname-$pkgver/src-tauri"
    cargo build --release --locked
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Install native binary
    install -Dm755 "src-tauri/target/release/mechon-ai" "$pkgdir/usr/bin/mechon-ai"

    # Install backend runtime assets
    install -d "$pkgdir/usr/lib/$pkgname/backend"
    cp -r backend/app "$pkgdir/usr/lib/$pkgname/backend/"
    install -Dm644 backend/requirements.txt "$pkgdir/usr/lib/$pkgname/backend/requirements.txt"

    # Install desktop entry
    install -Dm644 "$srcdir/mechon-ai.desktop" "$pkgdir/usr/share/applications/mechon-ai.desktop"

    # Install icons
    install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/mechon-ai.png"
    install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/mechon-ai.png"
    install -Dm644 "src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/mechon-ai.png"

    # Install documentation & license
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
